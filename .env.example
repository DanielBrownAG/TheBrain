PORT=3000
# Optional directory for local conversation history (default: ./data).
# BRAIN_DATA_DIR=D:/BrainData

# azure or openai (if omitted, an Azure endpoint selects azure)
AI_PROVIDER=azure

# Azure: use the deployment NAME, including deployments of GPT-6 variants.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_key_here
AZURE_DEPLOYMENT_ID=your_deployment_id_here

# For the OpenAI API, set AI_PROVIDER=openai and provide these instead.
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1
